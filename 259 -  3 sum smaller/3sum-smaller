class Solution:
    def countTriplets(self, sum, arr):
        #code here
        arr.sort()
        ans = 0
        for i in range(len(arr)):
            left = i + 1
            right = len(arr) - 1
            
            while left < right:
                total = arr[i] + arr[left] + arr[right]
                if total >= sum:
                    right -= 1
                else:
                    ans = ans + (right - left)
                    left += 1
        return ans